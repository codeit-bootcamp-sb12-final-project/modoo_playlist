SPRING_PROFILES_ACTIVE=dev

# User deletion
USER_DELETION_RETENTION=1d

# JWT
JWT_ACCESS_SECRET=replace-with-random-access-secret-at-least-32-bytes
JWT_REFRESH_SECRET=replace-with-different-random-refresh-secret-at-least-32-bytes
# 30 min
JWT_ACCESS_EXPIRATION_MS=1800000
# 7 days
JWT_REFRESH_EXPIRATION_MS=604800000
# 30 days
JWT_MAX_REFRESH_EXPIRATION_MS=2592000000
JWT_ISSUER=modoo-playlist

# Refresh cookie
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/api/auth

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Redis 일단 로컬이니까 신경 x
REDIS_HOST=localhost
REDIS_PORT=6379

# MySQL
MYSQL_ROOT_PASSWORD=
DB_USERNAME=
DB_PASSWORD=
DB_URL=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
OAUTH_SUCCESS_REDIRECT_URI=/#/home
OAUTH_FAILURE_REDIRECT_URI=/#/sign-in

# External services
GEMINI_API_KEY=
THESPORTSDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Image storage (local | s3)
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=.blog/storage
STORAGE_S3_BUCKET=
AWS_REGION=ap-northeast-2
# CloudFront URL or custom CDN domain (for example https://cdn.example.com)
STORAGE_PUBLIC_BASE_URL=

# Admin
ADMIN_ENABLED=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Bot
BOT_ENABLED=true
BOT_EMAIL=
BOT_NAME=

# SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=여기에_Brevo_SMTP_Login
SMTP_PASSWORD=여기에_Brevo_SMTP_Key
MAIL_FROM=no-reply@example.com
